[Unit]
Description=stele mailbox
Documentation=https://gitlab.com/__alexander__/stele
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
# Replace the address with this machine's Tailscale IP. Do not bind 0.0.0.0:
# the mailbox is plain HTTP and belongs on the tailnet only.
ExecStart=%h/.local/bin/stele --db %h/.local/share/stele/stele.db serve --bind 100.x.y.z:3900
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
